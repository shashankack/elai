# Mercur Store API (same backend as elai-client)
# On a physical device, use your machine's LAN IP — not localhost.
# Local: http://localhost:9000  |  Production: https://api.elaai.co
EXPO_PUBLIC_MEDUSA_URL=http://localhost:9000

# Publishable API key from Mercur admin → Settings → Publishable API Keys
# (same pk_ used by elai-client NEXT_PUBLIC_MERCUR_PUBLISHABLE_API_KEY)
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=pk_your_key_here

# Razorpay key id (same as elai-client NEXT_PUBLIC_RAZORPAY_KEY_ID)
# Session data usually includes key_id from the API; this is the fallback.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Optional — filled by `npx eas-cli init`
# EAS_PROJECT_ID=
