# Mercur vendor portal (seller register + onboarding)
NEXT_PUBLIC_MERCUR_VENDOR_URL=http://localhost:7001

# Mercur Store API (backend must be running, e.g. mercur dev:apps on :9000)
MERCUR_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MERCUR_BACKEND_URL=http://localhost:9000

# Publishable API key from Mercur admin → Settings → Publishable API Keys
MERCUR_PUBLISHABLE_API_KEY=pk_your_key_here

# Optional: pricing region (auto-detected from /store/regions if omitted)
# MERCUR_REGION_ID=reg_xxxxxxxx

# Razorpay public key (same as RAZORPAY_KEY_ID on the API). Required for Checkout.js.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
