# =============================================================================
# Mercur API  environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Redis (required) ---
REDIS_URL=redis://localhost:6379

# --- CORS (required for local dev) ---
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:7000,http://localhost:7001,http://localhost:9000

# --- Auth secrets (required in production; "supersecret" is rejected there) ---
JWT_SECRET=
COOKIE_SECRET=

# --- Mercur URLs (required in production for email links; no localhost fallback) ---
MERCUR_VENDOR_URL=http://localhost:7001
MERCUR_ADMIN_URL=http://localhost:7000
STOREFRONT_URL=http://localhost:3000

# --- Email (Resend) ---
# Create a key at https://resend.com   verify elaai.co in Resend Domains first
RESEND_API_KEY=
RESEND_FROM_EMAIL=Elai <noreply@elaai.co>
# Absolute logo URL for transactional emails (defaults to STOREFRONT_URL/logo.png)
# EMAIL_LOGO_URL=https://elaai.co/logo.png

# --- Razorpay (customer checkout) ---
# Create keys at https://dashboard.razorpay.com/app/keys
# When unset, storefront falls back to Medusa system/manual payment for local testing.
# Set RAZORPAY_WEBHOOK_SECRET in production; unverified webhooks are rejected when set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# After setting keys, link the provider to India:
#   bun run link:razorpay -- --force

# --- Destructive scripts ---
# wipe-db refuses non-local/Neon hosts unless MERCUR_ALLOW_WIPE_DB=1
# MERCUR_ALLOW_WIPE_DB=