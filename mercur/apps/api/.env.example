# =============================================================================
# Mercur API  environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Redis (required) ---
REDIS_URL=redis://localhost:6379

# --- CORS (required for local dev) ---
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000

# --- Auth secrets (change in production) ---
JWT_SECRET=
COOKIE_SECRET=

# --- Mercur URLs ---
MERCUR_VENDOR_URL=http://localhost:7001
MERCUR_ADMIN_URL=http://localhost:7000
STOREFRONT_URL=http://localhost:3000

# --- Email (Resend) ---
# Create a key at https://resend.com — verify elaai.co in Resend Domains first
RESEND_API_KEY=
RESEND_FROM_EMAIL=Elai <hello@elaai.co>
